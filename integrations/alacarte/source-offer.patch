@@ -0,0 +1,14 @@
+// Octocarte modification, 2026-09-07. AGPL-3.0-only; see LICENSE.
+import express from 'express'
+
+export function createSourceRouter(archivePath = '/usr/share/doc/alacarte/alacarte-source.tar.gz') {
+  const router = express.Router()
+  router.get('/octocarte-source.tar.gz', (_req, res) => {
+    res.download(archivePath, 'alacarte-source.tar.gz', (error) => {
+      if (error && !res.headersSent) {
+        res.status(503).json({ error: 'Build source archive is unavailable' })
+      }
+    })
+  })
+  return router
+}
