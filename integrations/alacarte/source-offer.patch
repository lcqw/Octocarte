diff --git a/backend/test/octocarteSource.test.mjs b/backend/test/octocarteSource.test.mjs
new file mode 100644
index 0000000..c76dcc2
--- /dev/null
+++ b/backend/test/octocarteSource.test.mjs
@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { mkdtemp, writeFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import path from 'node:path'
+import express from 'express'
+import { createSourceRouter } from '../routes/octocarteSource.mjs'
+
+test('source is public and exact; unrelated paths remain protected', async () => {
+  const dir = await mkdtemp(path.join(tmpdir(), 'octocarte-source-test-'))
+  const archive = path.join(dir, 'source.tar.gz')
+  const bytes = Buffer.from('controlled build source fixture')
+  await writeFile(archive, bytes)
+  const app = express()
+  app.use(createSourceRouter(archive))
+  app.use((_req, res) => res.sendStatus(401))
+  const server = app.listen(0, '127.0.0.1')
+  await new Promise(resolve => server.once('listening', resolve))
+  const base = `http://127.0.0.1:${server.address().port}`
+  try {
+    const response = await fetch(base + '/octocarte-source.tar.gz')
+    assert.equal(response.status, 200)
+    assert.match(response.headers.get('content-disposition'), /attachment.*alacarte-source/)
+    assert.deepEqual(Buffer.from(await response.arrayBuffer()), bytes)
+    for (const endpoint of ['/api/settings', '/config/settings.json', '/octocarte-source.tar.gz/extra']) {
+      assert.equal((await fetch(base + endpoint)).status, 401)
+    }
+    assert.equal((await fetch(base + '/octocarte-source.tar.gz', {method:'POST'})).status, 401)
+    await rm(archive)
+    const missing = await fetch(base + '/octocarte-source.tar.gz')
+    assert.equal(missing.status, 503)
+    assert.equal((await missing.text()).includes(dir), false)
+  } finally {
+    await new Promise(resolve => server.close(resolve))
+    await rm(dir, {recursive:true, force:true})
+  }
+})
