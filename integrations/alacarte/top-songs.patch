+// This read-only route inherits the normal /api authentication middleware.
+artistRouter.get('/:id/top-songs', async (req, res) => {
+  const id = String(req.params.id || '').trim()
+  const limit = Number(req.query.limit ?? 50)
+  if (!/^\d+$/.test(id) || !Number.isInteger(limit) || limit < 1 || limit > 50)
+    return res.status(400).json({ error: 'numeric artist id and limit 1..50 required' })
+  try {
+    const settings = await readSettings()
+    const storefront = settings.storefront || 'us'
+    const songs = await loadArtistTopSongs({ artistId: id, storefront,
+      language: settings.language || 'en-US', explicitFilter: settings.explicitFilter, limit })
+    res.json({ songs, storefront })
+  } catch {
+    res.status(502).json({ error: 'Artist top songs unavailable' })
+  }
+})
diff --git a/backend/lib/artistTopSongs.mjs b/backend/lib/artistTopSongs.mjs
