# Your existing Navidrome server, reachable from Docker (not localhost).
NAVIDROME_URL=http://<navidrome-host>:4533
# The music folder on this machine that Navidrome reads.
MUSIC_DIR=/path/to/your/music
# This machine's LAN IP; use 127.0.0.1 for local access only.
HOST_BIND=<octocarte-host-ip>

# Defaults normally need no changes.
OCTOCARTE_VERSION=0.0.6
OCTOCARTE_PORT=5274
ALACARTE_PORT=7373
