# Your existing Navidrome server, reachable from Docker (not localhost).
NAVIDROME_URL=http://192.168.1.100:4533
# The host music folder Navidrome already reads.
MUSIC_DIR=/path/to/music
# This machine's LAN address; use 127.0.0.1 for local access only.
HOST_BIND=127.0.0.1

# Defaults normally need no changes.
OCTOCARTE_VERSION=0.0.5-alpha.1
OCTOCARTE_PORT=5274
ALACARTE_PORT=7373
