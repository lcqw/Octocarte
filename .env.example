# Existing music folder on the Docker host (absolute path).
MUSIC_DIR=/path/to/music
# Use your NAS/LAN address for access from another device.
HOST_BIND=127.0.0.1

# Defaults normally need no changes.
OCTOCARTE_VERSION=0.0.5-alpha.1
OCTOCARTE_PORT=5274
ALACARTE_PORT=7373
NAVIDROME_PORT=4533

# For the existing-Navidrome example: its address from inside Docker.
NAVIDROME_URL=http://navidrome:4533
