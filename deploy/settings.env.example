# Absolute paths on the Docker host. Music must already exist.
DATA_DIR=/volume2/docker/octocarte
MUSIC_DIR=/volume1/Media/Music
# Set the NAS's private LAN address for phone access. Loopback is the safe default.
HOST_BIND=127.0.0.1
OCTOCARTE_PORT=5274
NAVIDROME_PORT=4533
ALACARTE_PORT=7373
NAVIDROME_UID=1000
NAVIDROME_GID=10
CONTAINER_SOCKET=/var/run/docker.sock
